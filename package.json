{
  "name": "tready",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": { "node": ">=24.3.0 <25" },
  "scripts": {
    "start": "pnpm --filter @tready/android start",
    "android": "pnpm --filter @tready/android android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "export:android": "pnpm --filter @tready/android export:android",
    "probe": "tsx scripts/probe.ts",
    "keyspike": "tsx scripts/key-spike.ts",
    "wsspike": "tsx scripts/ws-spike.ts",
    "enrollspike": "tsx scripts/enroll-spike.ts",
    "enrolle2e": "tsx scripts/enroll-e2e.ts"
  },
  "dependencies": {
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.0.1",
    "@scure/bip39": "2.0.1",
    "lossless-json": "4.3.1",
    "viem": "2.57.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
